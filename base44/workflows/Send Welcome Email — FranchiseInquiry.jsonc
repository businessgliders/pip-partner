{
  "name": "Send Welcome Email \u2014 FranchiseInquiry",
  "description": "",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "FranchiseInquiry"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_welcome_email_franchiseinquiry",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWelcomeEmail",
            "args": {
              "automation_secret": "{{secrets.WELCOME_EMAIL_AUTOMATION_SECRET}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendWelcomeEmail"
  }
}