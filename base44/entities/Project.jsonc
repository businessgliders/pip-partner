{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "details": {
      "type": "string",
      "description": "Optional notes or description"
    },
    "status": {
      "type": "string",
      "default": "todo",
      "description": "Kanban column key \u2014 matches TaskColumn.key"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Optional due date"
    },
    "lead_id": {
      "type": "string",
      "description": "ID of the linked lead ticket (optional)"
    },
    "lead_type": {
      "type": "string",
      "description": "Board key of the linked lead: franchise | instructor | frontadmin | influencer"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}