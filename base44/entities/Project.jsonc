{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Project title"
    },
    "details": {
      "type": "string",
      "description": "Optional notes or description"
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "working",
        "sent",
        "downloaded"
      ],
      "default": "backlog",
      "description": "Kanban column"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Optional due date"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}