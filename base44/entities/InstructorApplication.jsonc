{
  "name": "InstructorApplication",
  "type": "object",
  "properties": {
    "display_ticket_number": {
      "type": "integer",
      "description": "Obfuscated public ticket number shown in UI (derived from app_number)"
    },
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email address"
    },
    "preferred_studio": {
      "type": "string",
      "description": "Preferred studio location"
    },
    "postal_code": {
      "type": "string",
      "description": "Postal code"
    },
    "province": {
      "type": "string",
      "enum": [
        "Alberta",
        "British Columbia",
        "Manitoba",
        "New Brunswick",
        "Newfoundland and Labrador",
        "Nova Scotia",
        "Northwest Territories",
        "Nunavut",
        "Ontario",
        "Prince Edward Island",
        "Quebec",
        "Saskatchewan",
        "Yukon"
      ],
      "description": "Province"
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Personal Training / Group Fitness Cert",
          "Kinesiology Degree or Similar",
          "Pilates, Dance or Performance Trained",
          "6+ Months of Coaching Experience",
          "CPR/AED/First Aid Training"
        ]
      },
      "description": "Applicable qualifications"
    },
    "resume_url": {
      "type": "string",
      "description": "URL of uploaded resume"
    },
    "message": {
      "type": "string",
      "description": "Additional message or motivation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "shortlisted",
        "invited",
        "declined",
        "ghosted"
      ],
      "default": "pending",
      "description": "Application status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the admin user assigned to this ticket"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "internal_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Internal staff notes thread"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "link"
            ]
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Files and Google Docs/Drive links attached to this ticket"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "description": "Internal staff notes"
    },
    "app_number": {
      "type": "integer",
      "description": "Auto-incremented application number (raw sequential)"
    },
    "ai_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "body_html": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "ai_suggestions_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_suggestions_message_count": {
      "type": "integer"
    },
    "manual_sort_index": {
      "type": "number",
      "description": "Per-ticket sort position for manual reordering within a swimlane."
    },
    "follow_up": {
      "type": "object",
      "description": "Intelligent automated follow-up sequence state.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "step": {
          "type": "integer",
          "default": 0
        },
        "max_steps": {
          "type": "integer",
          "default": 5
        },
        "next_send_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "enabled_at": {
          "type": "string",
          "format": "date-time"
        },
        "enabled_by": {
          "type": "string"
        },
        "paused_reason": {
          "type": "string",
          "enum": [
            "replied",
            "manual_reply",
            "completed",
            "stopped",
            ""
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer"
              },
              "sent_at": {
                "type": "string",
                "format": "date-time"
              },
              "email_message_id": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "interval_days": {
                "type": "number"
              }
            }
          },
          "default": []
        }
      }
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}