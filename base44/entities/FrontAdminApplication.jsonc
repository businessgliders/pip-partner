{
  "name": "FrontAdminApplication",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email address"
    },
    "preferred_studio": {
      "type": "string",
      "description": "Preferred studio location"
    },
    "postal_code": {
      "type": "string",
      "description": "Postal code"
    },
    "province": {
      "type": "string",
      "enum": [
        "Alberta",
        "British Columbia",
        "Manitoba",
        "New Brunswick",
        "Newfoundland and Labrador",
        "Nova Scotia",
        "Northwest Territories",
        "Nunavut",
        "Ontario",
        "Prince Edward Island",
        "Quebec",
        "Saskatchewan",
        "Yukon"
      ],
      "description": "Province"
    },
    "resume_url": {
      "type": "string",
      "description": "URL of uploaded resume"
    },
    "message": {
      "type": "string",
      "description": "Additional message or motivation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "invited",
        "declined"
      ],
      "default": "pending",
      "description": "Application status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "description": "Internal staff notes"
    },
    "app_number": {
      "type": "integer",
      "description": "Auto-incremented application number"
    },
    "ai_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "body_html": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "ai_suggestions_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_suggestions_message_count": {
      "type": "integer"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}