{
  "name": "InfluencerApplication",
  "type": "object",
  "properties": {
    "display_ticket_number": {
      "type": "integer",
      "description": "Obfuscated public ticket number shown in UI (derived from app_number)"
    },
    "full_name": {
      "type": "string",
      "description": "Applicant's full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email address"
    },
    "instagram_handle": {
      "type": "string",
      "description": "Instagram username"
    },
    "tiktok_handle": {
      "type": "string",
      "description": "TikTok username"
    },
    "follower_count": {
      "type": "string",
      "enum": [
        "1K-5K",
        "5K-10K",
        "10K-25K",
        "25K-50K",
        "50K-100K",
        "100K+"
      ],
      "description": "Approximate number of followers"
    },
    "location": {
      "type": "string",
      "description": "City/Location"
    },
    "why_partner": {
      "type": "string",
      "description": "Why they want to partner with Pilates in Pink"
    },
    "content_style": {
      "type": "string",
      "enum": [
        "Fitness & Wellness",
        "Lifestyle",
        "Fashion",
        "Health & Nutrition",
        "Other"
      ],
      "description": "Primary content focus"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "default": "pending",
      "description": "Application status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the admin user assigned to this ticket"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "internal_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Internal staff notes thread"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "link"
            ]
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Files and Google Docs/Drive links attached to this ticket"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "description": "Internal staff notes"
    },
    "app_number": {
      "type": "integer",
      "description": "Auto-incremented application number (raw sequential)"
    },
    "ai_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "body_html": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "ai_suggestions_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_suggestions_message_count": {
      "type": "integer"
    },
    "manual_sort_index": {
      "type": "number",
      "description": "Per-ticket sort position for manual reordering within a swimlane."
    },
    "follow_up": {
      "type": "object",
      "description": "Intelligent automated follow-up sequence state.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "step": {
          "type": "integer",
          "default": 0
        },
        "max_steps": {
          "type": "integer",
          "default": 5
        },
        "next_send_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "enabled_at": {
          "type": "string",
          "format": "date-time"
        },
        "enabled_by": {
          "type": "string"
        },
        "paused_reason": {
          "type": "string",
          "enum": [
            "replied",
            "manual_reply",
            "completed",
            "stopped",
            ""
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer"
              },
              "sent_at": {
                "type": "string",
                "format": "date-time"
              },
              "email_message_id": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "interval_days": {
                "type": "number"
              }
            }
          },
          "default": []
        }
      }
    }
  },
  "required": [
    "full_name",
    "email",
    "instagram_handle"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}