{
  "name": "InfluencerApplication",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Applicant's full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email address"
    },
    "instagram_handle": {
      "type": "string",
      "description": "Instagram username"
    },
    "tiktok_handle": {
      "type": "string",
      "description": "TikTok username"
    },
    "follower_count": {
      "type": "string",
      "enum": [
        "1K-5K",
        "5K-10K",
        "10K-25K",
        "25K-50K",
        "50K-100K",
        "100K+"
      ],
      "description": "Approximate number of followers"
    },
    "location": {
      "type": "string",
      "description": "City/Location"
    },
    "why_partner": {
      "type": "string",
      "description": "Why they want to partner with Pilates in Pink"
    },
    "content_style": {
      "type": "string",
      "enum": [
        "Fitness & Wellness",
        "Lifestyle",
        "Fashion",
        "Health & Nutrition",
        "Other"
      ],
      "description": "Primary content focus"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "default": "pending",
      "description": "Application status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "app_number": {
      "type": "integer",
      "description": "Auto-incremented application number"
    },
    "ai_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "body_html": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "ai_suggestions_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_suggestions_message_count": {
      "type": "integer"
    }
  },
  "required": [
    "full_name",
    "email",
    "instagram_handle"
  ]
}