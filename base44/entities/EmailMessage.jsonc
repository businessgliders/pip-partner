{
  "name": "EmailMessage",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "ID of the source submission this email belongs to"
    },
    "ticket_type": {
      "type": "string",
      "enum": [
        "FranchiseInquiry",
        "InfluencerApplication",
        "InstructorApplication",
        "FrontAdminApplication"
      ],
      "description": "Entity name of the parent submission"
    },
    "gmail_thread_id": {
      "type": "string"
    },
    "gmail_message_id": {
      "type": "string"
    },
    "rfc_message_id": {
      "type": "string"
    },
    "in_reply_to": {
      "type": "string"
    },
    "references": {
      "type": "string",
      "description": "Full RFC 2822 References header chain"
    },
    "direction": {
      "type": "string",
      "enum": [
        "outbound",
        "inbound"
      ]
    },
    "from_email": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "to_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body_html": {
      "type": "string"
    },
    "body_text": {
      "type": "string"
    },
    "snippet": {
      "type": "string"
    },
    "sent_by": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_welcome": {
      "type": "boolean",
      "default": false
    },
    "is_internal": {
      "type": "boolean",
      "default": false,
      "description": "True when this is an internal team-to-team email (not sent to the applicant)"
    },
    "send_status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "received"
      ],
      "default": "received"
    },
    "send_error": {
      "type": "string"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "read_at": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "ticket_id",
    "ticket_type",
    "direction",
    "subject"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}