{
  "name": "FranchiseInquiry",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "full_name": {
      "type": "string",
      "description": "Applicant's full name (legacy)"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email address"
    },
    "phone_country": {
      "type": "string",
      "description": "Phone country"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "city": {
      "type": "string",
      "description": "City / Preferred territory (legacy)"
    },
    "province": {
      "type": "string",
      "enum": [
        "Alberta",
        "British Columbia",
        "Manitoba",
        "New Brunswick",
        "Newfoundland and Labrador",
        "Nova Scotia",
        "Northwest Territories",
        "Nunavut",
        "Ontario",
        "Prince Edward Island",
        "Quebec",
        "Saskatchewan",
        "Yukon"
      ],
      "description": "Province where they'd love to have a Pilates in Pink studio"
    },
    "preferred_location": {
      "type": "string",
      "description": "Province and Town/City preferred location"
    },
    "preferred_postal_code": {
      "type": "string",
      "description": "Preferred postal code for the desired studio location (own postal code if unknown)"
    },
    "available_capital": {
      "type": "string",
      "enum": [
        "$100K - $200K",
        "$200K - $300K",
        "$300K+"
      ],
      "description": "Available liquid capital in CAD"
    },
    "investment_readiness": {
      "type": "string",
      "description": "Legacy capital range"
    },
    "operation_style": {
      "type": "string",
      "enum": [
        "Owner-Operator (hands-on daily)",
        "Semi-Absentee (with a manager)",
        "Investor (fully managed)",
        "Multi-Unit Developer"
      ],
      "description": "How they'd like to operate their studio"
    },
    "ready_to_sign_nda": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Need more info first"
      ],
      "description": "Whether they're ready to sign the NDA"
    },
    "why_pilates_in_pink": {
      "type": "string",
      "enum": [
        "Passion for wellness & movement",
        "Love the brand & aesthetic",
        "Business opportunity",
        "Community impact",
        "Other"
      ],
      "description": "Why Pilates in Pink"
    },
    "business_experience": {
      "type": "string",
      "description": "Business or related experience"
    },
    "timeline": {
      "type": "string",
      "description": "Timeline for moving forward (legacy)"
    },
    "scheduled_call_time": {
      "type": "string",
      "description": "Selected discovery call slot"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "scheduled",
        "contacted",
        "qualified",
        "closed"
      ],
      "default": "new"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the admin user assigned to this ticket"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "internal_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Internal staff notes thread"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "link"
            ]
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Files and Google Docs/Drive links attached to this ticket"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "description": "Internal staff notes"
    },
    "app_number": {
      "type": "integer",
      "description": "Auto-incremented application number"
    },
    "ai_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "body_html": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "ai_suggestions_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_suggestions_message_count": {
      "type": "integer"
    },
    "resume_pin_hash": {
      "type": "string",
      "description": "SHA-256 hash of the 6-digit resume PIN"
    },
    "resume_pin_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry timestamp for the resume PIN"
    },
    "resume_pin_attempts": {
      "type": "integer",
      "default": 0,
      "description": "Number of failed PIN verification attempts"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}