{
  "name": "TaskColumn",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Stable column key referenced by Project.status"
    },
    "label": {
      "type": "string",
      "description": "Display name of the swimlane"
    },
    "order": {
      "type": "number",
      "description": "Sort position, ascending"
    }
  },
  "required": [
    "key",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}